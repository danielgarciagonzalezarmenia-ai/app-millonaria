# Config de la app web (https://console.firebase.google.com)
# Proyecto -> Configuracion del proyecto -> Tus apps -> App web -> SDK
VITE_FIREBASE_API_KEY=cambia
VITE_FIREBASE_AUTH_DOMAIN=cambia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cambia
VITE_FIREBASE_STORAGE_BUCKET=cambia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=cambia
VITE_FIREBASE_APP_ID=cambia

# URL del backend (desarrollo)
VITE_API_URL=http://localhost:8000