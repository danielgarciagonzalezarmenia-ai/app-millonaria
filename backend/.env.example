# ---------- Entorno ----------
ENV=development
APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# ---------- Firebase ----------
# 1) Ve a Firebase Console -> Proyecto -> Configuracion del proyecto
# 2) Cuentas de servicio -> Firebase Admin SDK -> Generar clave privada
# 3) Guarda el JSON y pon aqui el path (recomendado) o en GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_SERVICE_ACCOUNT_PATH=C:\ruta\al\service-account.json

# ---------- TipsterPage (pagos) ----------
# Secreto que pondras en TipsterPage como firma de webhook.
# Generalo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TIPSTERPAGE_WEBHOOK_SECRET=cambia-este-secreto
# Link del producto que creaste en TipsterPage (https://app.tipsterpage.com)
TIPSTERPAGE_PRODUCT_URL=https://app.tipsterpage.com/p/xyz
PREMIUM_PRICE_USD=9.99

# ---------- Scraper ----------
MIN_ODDS=1.70
SCRAPED_MATCHES_LIMIT=30
# Si se rellena, solo analiza esas ligas (nombres exactos de 365scores):
# SCRAPER_LEAGUES=["LaLiga","Premier League","Serie A","Bundesliga","Ligue 1","Liga MX - Apertura"]
SCRAPER_LEAGUES=[]
# Ligas que siempre serán premium (nunca ocupan el cupo gratis del día)
PREMIUM_LEAGUES=[]

# ---------- Política de gratis por día ----------
# Con pocos pronósticos al día se regala 1; con bastantes, 2.
FREE_PREDICTIONS_WHEN_FEW=1
FREE_PREDICTIONS_WHEN_MANY=2
# Si el día tiene menos pronósticos que este umbral se considera "pocos".
FREE_PREDICTIONS_THRESHOLD=5

# ---------- Admin (tu uid de Firebase) ----------
# Lo puedes ver en /api/me tras iniciar sesion con tu cuenta.
ADMIN_UIDS=[]